# Official Super Market /api/v1 credentials.
# Never commit the real key.
SUSQ_API_KEY=

# Official default is Authorization: Bearer <key>.
# X-API-Key is also supported; override only if desired.
SUSQ_AUTH_HEADER=Authorization
SUSQ_AUTH_PREFIX=Bearer 

# Official production API from the OpenAPI reference.
SUSQ_BASE_URL=https://www.thesuper.market/api/v1

# Set this to the Predictions Cup tournament slug discovered by the read-only
# smoke test. Keeping the slug explicit prevents accidental default-tournament
# context drift.
SUSQ_TOURNAMENT_SLUG=

# Fail-closed live gate. Keep 0 through read-only and paper validation.
PMC_ALLOW_LIVE_TRADING=0
PMC_LIVE_ACK=
PMC_MIN_EDGE=0.01
PMC_MAX_ORDER_SIZE=100
PMC_MAX_MARKET_EXPOSURE=2500
PMC_MAX_TOTAL_EXPOSURE=20000
PMC_MIN_CASH_BUFFER=5000
PMC_MAX_BOOK_AGE_SECONDS=2
PMC_MAX_SLIPPAGE=0.01
