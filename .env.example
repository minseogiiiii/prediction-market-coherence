# Never commit the real key.
SUSQ_API_KEY=
SUSQ_AUTH_HEADER=
SUSQ_AUTH_PREFIX=

# Copy exact paths from https://sig.thesuper.market/api/v1/docs
# Do not guess them. Placeholders supported: {market_id}, {order_id}
SUSQ_PATH_MARKETS=
SUSQ_PATH_MARKET=
SUSQ_PATH_ORDERBOOK=
SUSQ_PATH_POSITIONS=
SUSQ_PATH_ORDERS=
SUSQ_PATH_ORDER=
SUSQ_PATH_CANCEL_ORDER=
SUSQ_PATH_BALANCE=

# Fail-closed live gate. Keep 0 during development/paper trading.
PMC_ALLOW_LIVE_TRADING=0
PMC_LIVE_ACK=
PMC_MIN_EDGE=0.01
PMC_MAX_ORDER_SIZE=100
PMC_MAX_MARKET_EXPOSURE=2500
PMC_MAX_TOTAL_EXPOSURE=20000
PMC_MIN_CASH_BUFFER=5000
PMC_MAX_BOOK_AGE_SECONDS=2
PMC_MAX_SLIPPAGE=0.01
